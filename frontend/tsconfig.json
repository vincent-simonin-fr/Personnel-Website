{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "components/*": ["./src/components/*"],
      "providers/*": ["./src/providers/*"],
      "hooks/*": ["./src/hooks/*"],
      "i18n/*": ["./i18n/*"],
      "styles/*": ["./src/styles/*"],
      "seo/*": ["./seo/*"],
      "config/*": ["./config/*"],
      "types": ["./src/types/index"],
      "actions": ["./src/lib/actions/actions"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/i18n/dictionaries.ts",
    "src/components/ui/animations/hyperspeed/index.jsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
